{
  "name": "phylotank",
  "version": "0.0.1",
  "description": "An artificial-life fishtank: glowing deep-sea creatures with evolved bodies and brains, as a wallpaper, screensaver, TV view and god window.",
  "license": "Unlicense",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && node scripts/build.mjs",
    "dev": "node scripts/build.mjs --dev",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/build.mjs && node tests/e2e/smoke.cjs",
    "host": "node scripts/build.mjs && node dist/host.mjs"
  },
  "dependencies": {
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
